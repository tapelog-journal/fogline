{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fogline-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "rules": [{ "type": "Text", "globs": ["**/*.md", "**/*.txt"], "fallthrough": true }],
  "observability": { "enabled": true },
  "vars": {
    "CHAIN_ID": "84532",
    "RPC_URL": "https://sepolia.base.org",
    "RPC_FALLBACKS": "https://base-sepolia-rpc.publicnode.com,https://base-sepolia.drpc.org",
    "GAME": "0x059db9310c1DFB3009DAd13d043589DDBe75C874",
    "TOKEN": "0xb7554a491459ff75A41080b96C2BA098c4e12eFd",
    "WATCH_BASE": "https://tapelog-journal.github.io/fogline/"
  },
  // Secrets (set with `wrangler secret put`, never committed): FUNDER_KEY, HOUSE_KEY, IP_SALT
  "durable_objects": {
    "bindings": [
      { "name": "PLAYER", "class_name": "Player" },
      { "name": "HOUSE", "class_name": "House" },
      { "name": "FUNDER", "class_name": "Funder" },
      { "name": "SSE", "class_name": "SseSession" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Player", "House", "Funder", "SseSession"] }]
}
